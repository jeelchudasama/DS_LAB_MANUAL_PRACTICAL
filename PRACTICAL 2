#include <stdio.h>

int arr[5] = {1, 2, 3, 4, 5}, i, s = 5;

int main()
{
    int opt, del, srch, found;

    printf("Array operations:\n");
    printf("Insertion : 1\n");
    printf("Deletion : 2\n");
    printf("Searching : 3\n");
    printf("Display All : 4\n");
    printf("Exit : any other\n");

    while (1)
    {
        printf("Enter your option: ");
        scanf("%d", &opt);

        switch (opt)
        {
            case 1:
                for (i = 0; i < 5; i++)
                {
                    printf("Arr[%d] = ", i);
                    scanf("%d", &arr[i]);
                }

                s = 5;
                break;

            case 2:
                printf("Enter index of element to delete: ");
                scanf("%d", &del);

                if (del < s && del >= 0)
                {
                    for (i = del; i < s - 1; i++)
                    {
                        arr[i] = arr[i + 1];
                    }

                    s--;
                    printf("Element deleted successfully\n");
                }
                else
                {
                    printf("Invalid index\n");
                }

                break;

            case 3:
                printf("Enter element to search: ");
                scanf("%d", &srch);

                found = 0;

                for (i = 0; i < s; i++)
                {
                    if (arr[i] == srch)
                    {
                        printf("Index is \"%d\"\n", i);
                        found = 1;
                        break;
                    }
                }

                if (!found)
                {
                    printf("Element not found\n");
                }

                break;

            case 4:
                for (i = 0; i < s; i++)
                {
                    printf("Array[%d] = %d\n", i, arr[i]);
                }

                break;

            default:
                printf("Program exited successfully\n");
                return 0;
        }
    }

    return 0;
}



